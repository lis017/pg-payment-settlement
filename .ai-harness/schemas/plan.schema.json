{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Harness Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId", "objective", "acceptanceCriteria", "evidence", "allowedPaths",
    "forbiddenPaths", "dbImpact", "apiImpact", "risks", "tests", "nonGoals", "rollback"
  ],
  "properties": {
    "taskId": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "allowedPaths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "forbiddenPaths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "dbImpact": { "type": "string", "minLength": 1 },
    "apiImpact": { "type": "string", "minLength": 1 },
    "risks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "tests": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "nonGoals": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "rollback": { "type": "string", "minLength": 1 }
  }
}
