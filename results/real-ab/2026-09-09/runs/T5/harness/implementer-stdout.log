{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"\"C:\\\\Users\\\\user\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Get-Content -Raw -LiteralPath 'src/main/java/com/toss/cashback/domain/settlement/service/SettlementDateCalculator.java'; Get-Item -LiteralPath 'src/main/java/com/toss/cashback/domain/settlement/service/SettlementDateCalculator.java' | Select-Object FullName,Length\"","aggregated_output":"package com.toss.cashback.domain.settlement.service;\n\nimport java.time.DayOfWeek;\nimport java.time.LocalDate;\nimport java.util.Set;\n\npublic final class SettlementDateCalculator {\n\n    private SettlementDateCalculator() {\n    }\n\n    public static LocalDate calculate(LocalDate paymentDate, int businessDays, Set<LocalDate> holidays) {\n        if (paymentDate == null || businessDays < 0) {\n            throw new IllegalArgumentException(\"paymentDate must not be null and businessDays must not be negative\");\n        }\n\n        if (businessDays == 0) {\n            return paymentDate;\n        }\n\n        int elapsedBusinessDays = 0;\n        LocalDate settlementDate = paymentDate;\n\n        while (elapsedBusinessDays < businessDays) {\n            settlementDate = settlementDate.plusDays(1);\n            DayOfWeek dayOfWeek = settlementDate.getDayOfWeek();\n\n            if (dayOfWeek != DayOfWeek.SATURDAY\n                    && dayOfWeek != DayOfWeek.SUNDAY\n                    && (holidays == null || !holidays.contains(settlementDate))) {\n                elapsedBusinessDays++;\n            }\n        }\n\n        return settlementDate;\n    }\n}\n\r\n\r\nFullName\r\n--------                                                                                                               \r\nC:\\Users\\user\\Desktop\\pg-payment-settlement-master\\.real-ab-workspaces-4f2ZIN\\T5\\harness\\src\\main\\java\\com\\toss\\cashba…\r\n\r\n","exit_code":0,"stat