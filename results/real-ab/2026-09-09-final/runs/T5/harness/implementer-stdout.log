{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"\"C:\\\\Users\\\\user\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Get-Content -LiteralPath 'src/main/java/com/toss/cashback/domain/settlement/service/SettlementDateCalculator.java'; Get-ChildItem -LiteralPath 'src/main/java/com/toss/cashback/domain/settlement/service/SettlementDateCalculator.java' | Select-Object -ExpandProperty FullName\"","aggregated_output":"package com.toss.cashback.domain.settlement.service;\r\n\r\nimport java.time.DayOfWeek;\r\nimport java.time.LocalDate;\r\nimport java.util.Set;\r\n\r\npublic final class SettlementDateCalculator {\r\n\r\n    private SettlementDateCalculator() {\r\n    }\r\n\r\n    public static LocalDate calculate(LocalDate paymentDate, int businessDays, Set<LocalDate> holidays) {\r\n        if (paymentDate == null || businessDays < 0) {\r\n            throw new IllegalArgumentException();\r\n        }\r\n\r\n        if (businessDays == 0) {\r\n            return paymentDate;\r\n        }\r\n\r\n        LocalDate date = paymentDate;\r\n        int countedBusinessDays = 0;\r\n        while (countedBusinessDays < businessDays) {\r\n            date = date.plusDays(1);\r\n            if (isBusinessDay(date, holidays)) {\r\n                countedBusinessDays++;\r\n            }\r\n        }\r\n        return date;\r\n    }\r\n\r\n    private static boolean isBusinessDay(LocalDate date, Set<LocalDate> holidays) {\r\n        DayOfWeek dayOfWeek = date.getDayOfWeek();\r\n        return dayOfWeek != DayOfWeek.SATURDAY\r\n                && dayOfWeek != DayOfWeek.SUNDAY\r\n                && (holidays == null || !holidays.contains(date));\r\n    }\r\n}\r\nC:\\Users\\user\\Desktop\\pg-payment-settlement-master\\.real-ab-workspaces-0I0fts\\T5\\harness\\src\\main\\java\\com\\toss\\cashback\\domain\\settlement\\service\\SettlementDateCalculator.java\r\n","exit_code":0,"status":"completed"}}
